@model VeterinerKlinikSistemi.Models.Veteriner
@{
    ViewData["Title"] = "Veteriner Düzenle";
    var hizmetler = ViewBag.Hizmetler as List<VeterinerKlinikSistemi.Models.Hizmet> ?? new();
    var secilenIds = ViewBag.SecilenHizmetIds as List<int> ?? new();
}

<h2>Veteriner Düzenle</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Duzenle" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="KlinikId" class="form-label">Klinik</label>
                <select asp-for="KlinikId" asp-items="ViewBag.Klinikler" class="form-select"></select>
                <span asp-validation-for="KlinikId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AdSoyad" class="form-label">Ad Soyad</label>
                <input asp-for="AdSoyad" class="form-control" />
                <span asp-validation-for="AdSoyad" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UzmanlikAlani" class="form-label">Uzmanlık Alanı</label>
                <input asp-for="UzmanlikAlani" class="form-control" />
                <span asp-validation-for="UzmanlikAlani" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Verdiği Hizmetler</label>
                <div class="border rounded p-2">
                    @foreach (var hizmet in hizmetler)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="secilenHizmetler" value="@hizmet.Id"
                                   id="hizmet_@hizmet.Id" @(secilenIds.Contains(hizmet.Id) ? "checked" : "") />
                            <label class="form-check-label" for="hizmet_@hizmet.Id">@hizmet.Ad (@hizmet.SureDakika dk)</label>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-warning">Güncelle</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}