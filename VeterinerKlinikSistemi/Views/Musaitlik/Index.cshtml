@model IEnumerable<VeterinerKlinikSistemi.Models.VeterinerMusaitlik>
@{
    ViewData["Title"] = "Veteriner Müsaitlik Saatleri";
    string GunAdi(DayOfWeek gun) => gun switch
    {
        DayOfWeek.Monday => "Pazartesi",
        DayOfWeek.Tuesday => "Salı",
        DayOfWeek.Wednesday => "Çarşamba",
        DayOfWeek.Thursday => "Perşembe",
        DayOfWeek.Friday => "Cuma",
        DayOfWeek.Saturday => "Cumartesi",
        DayOfWeek.Sunday => "Pazar",
        _ => gun.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Veteriner Müsaitlik Saatleri</h2>
    <a asp-action="Ekle" class="btn btn-primary">+ Yeni Müsaitlik Ekle</a>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Veteriner Hekim</th>
            <th>Klinik</th>
            <th>Gün</th>
            <th>Saat Aralığı</th>
            <th style="width: 180px;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Veteriner?.AdSoyad</td>
                <td>@item.Veteriner?.Klinik?.Ad</td>
                <td>@GunAdi(item.Gun)</td>
                <td>@item.BaslangicSaati.ToString(@"hh\:mm") - @item.BitisSaati.ToString(@"hh\:mm")</td>
                <td>
                    <a asp-action="Duzenle" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    <form asp-action="Sil" asp-route-id="@item.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bu müsaitlik kaydını silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>