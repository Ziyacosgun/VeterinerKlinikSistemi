@model IEnumerable<VeterinerKlinikSistemi.Models.EvcilHayvan>
@{
    ViewData["Title"] = "Evcil Hayvanlarım";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Evcil Hayvanlarım</h2>
    <a asp-action="Ekle" class="btn btn-primary">+ Yeni Evcil Hayvan Ekle</a>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz kayıtlı bir evcil hayvanınız yok. Hemen ekleyebilirsiniz.</div>
}
else
{
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Ad</th>
                <th>Tür</th>
                <th>Irk</th>
                <th>Doğum Tarihi</th>
                <th>Kilo</th>
                <th>Aşı Sayısı</th>
                <th style="width: 260px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Ad</td>
                    <td>@item.Tur</td>
                    <td>@item.Irk</td>
                    <td>@item.DogumTarihi.ToString("dd.MM.yyyy")</td>
                    <td>@item.Kilo kg</td>
                    <td>
                        <span class="badge bg-secondary">@item.AsiKayitlari.Count</span>
                    </td>
                    <td>
                        <a asp-action="AsiGecmisi" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Aşılar</a>
                        <a asp-action="Duzenle" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                        <form asp-action="Sil" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">
                            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}