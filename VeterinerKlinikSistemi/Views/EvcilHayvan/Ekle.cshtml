@model VeterinerKlinikSistemi.Models.EvcilHayvan
@{
    ViewData["Title"] = "Yeni Evcil Hayvan Ekle";
}

<h2>Yeni Evcil Hayvan Ekle</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Ekle" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Ad" class="form-label">Ad</label>
                <input asp-for="Ad" class="form-control" placeholder="Örn: Pamuk, Karabaş" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Tur" class="form-label">Tür</label>
                    <input asp-for="Tur" class="form-control" placeholder="Örn: Kedi, Köpek, Kuş" />
                    <span asp-validation-for="Tur" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Irk" class="form-label">Irk</label>
                    <input asp-for="Irk" class="form-control" placeholder="Örn: Tekir, Golden Retriever" />
                    <span asp-validation-for="Irk" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DogumTarihi" class="form-label">Doğum Tarihi</label>
                    <input asp-for="DogumTarihi" type="date" class="form-control" />
                    <span asp-validation-for="DogumTarihi" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Kilo" class="form-label">Kilo (kg)</label>
                    <input asp-for="Kilo" type="number" step="0.1" class="form-control" />
                    <span asp-validation-for="Kilo" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="FotografUrl" class="form-label">Fotoğraf URL (Opsiyonel)</label>
                <input asp-for="FotografUrl" class="form-control" placeholder="https://..." />
                <span asp-validation-for="FotografUrl" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}