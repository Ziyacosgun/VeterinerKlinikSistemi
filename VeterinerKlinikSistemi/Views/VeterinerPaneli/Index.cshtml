@model IEnumerable<VeterinerKlinikSistemi.Models.Randevu>
@using VeterinerKlinikSistemi.Models
@{
    ViewData["Title"] = "Veteriner Paneli - Randevularım";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Veteriner Paneli</h2>
        @if (ViewBag.VeterinerBilgi != null)
        {
            <small class="text-muted">@ViewBag.VeterinerBilgi</small>
        }
    </div>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

@if (ViewBag.ProfilEksik == true)
{
    <div class="alert alert-warning">
        Bu kullanıcı hesabı henüz bir veteriner hekim kaydıyla eşleştirilmemiş. Admin panelinden ilgili veteriner kaydına bu kullanıcıyı bağlayınız.
    </div>
}
else if (!Model.Any())
{
    <div class="alert alert-info">Size ait henüz bir randevu kaydı bulunmuyor.</div>
}
else
{
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Tarih / Saat</th>
                <th>Evcil Hayvan</th>
                <th>Hayvan Sahibi</th>
                <th>Hizmet</th>
                <th>Durum</th>
                <th style="width: 240px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RandevuTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <span class="fw-semibold">@item.EvcilHayvan?.Ad</span><br />
                        <small class="text-muted">@item.EvcilHayvan?.Tur / @item.EvcilHayvan?.Irk</small>
                    </td>
                    <td>
                        @item.EvcilHayvan?.Sahip?.AdSoyad<br />
                        <small class="text-muted">@item.EvcilHayvan?.Sahip?.Email</small>
                    </td>
                    <td>@item.Hizmet?.Ad (@item.SureDakika dk)</td>
                    <td>
                        @switch (item.Durum)
                        {
                            case RandevuDurumu.Bekliyor:
                                <span class="badge bg-warning text-dark">Bekliyor</span>
                                break;
                            case RandevuDurumu.Onaylandi:
                                <span class="badge bg-success">Onaylandı</span>
                                break;
                            case RandevuDurumu.Reddedildi:
                                <span class="badge bg-danger">Reddedildi</span>
                                break;
                            case RandevuDurumu.Tamamlandi:
                                <span class="badge bg-primary">Tamamlandı</span>
                                break;
                        }
                    </td>
                    <td>
                        @if (item.Durum == RandevuDurumu.Bekliyor)
                        {
                            <form asp-action="Onayla" asp-route-id="@item.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                            </form>
                            <form asp-action="Reddet" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu randevuyu reddetmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-danger">Reddet</button>
                            </form>
                        }
                        else if (item.Durum == RandevuDurumu.Onaylandi || item.Durum == RandevuDurumu.Tamamlandi)
                        {
                            <a asp-action="Muayene" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                Muayene & Aşı
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}