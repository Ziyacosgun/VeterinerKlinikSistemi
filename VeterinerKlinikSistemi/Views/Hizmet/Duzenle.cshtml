@model VeterinerKlinikSistemi.Models.Hizmet
@{
    ViewData["Title"] = "Hizmet Düzenle";
}

<h2>Hizmet Düzenle</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Duzenle" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="KlinikId" class="form-label">Klinik</label>
                <select asp-for="KlinikId" asp-items="ViewBag.Klinikler" class="form-select"></select>
                <span asp-validation-for="KlinikId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Ad" class="form-label">Hizmet Adı</label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SureDakika" class="form-label">Süre (Dakika)</label>
                    <input asp-for="SureDakika" type="number" class="form-control" />
                    <span asp-validation-for="SureDakika" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Ucret" class="form-label">Ücret (₺)</label>
                    <input asp-for="Ucret" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Ucret" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label">Açıklama</label>
                <textarea asp-for="Aciklama" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Aciklama" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-warning">Güncelle</button>
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}