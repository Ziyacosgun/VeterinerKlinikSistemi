@model IEnumerable<VeterinerKlinikSistemi.Models.Klinik>
@{
    ViewData["Title"] = "Klinik Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Klinikler</h2>
    <a asp-action="Ekle" class="btn btn-primary">+ Yeni Klinik Ekle</a>
</div>

@if (TempData["Basari"] != null)
{
    <div class="alert alert-success">@TempData["Basari"]</div>
}

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Klinik Adı</th>
            <th>Adres</th>
            <th>Telefon</th>
            <th>Çalışma Saatleri</th>
            <th style="width: 180px;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Ad</td>
                <td>@item.Adres</td>
                <td>@item.Telefon</td>
                <td>@item.AcilisSaati.ToString(@"hh\:mm") - @item.KapanisSaati.ToString(@"hh\:mm")</td>
                <td>
                    <a asp-action="Duzenle" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    <form asp-action="Sil" asp-route-id="@item.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bu kliniği silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>